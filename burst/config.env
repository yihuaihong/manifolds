# What the Burst sentinel may do. Claude edits this file and commits; the sentinel re-reads it every minute.
#   ENABLED=0  -> submit nothing new (running tasks finish; nothing is cancelled)
#   ENABLED=1  -> submit every ready task in tasks/ (see README for the task header format)
ENABLED=1
ACCOUNT=ds_ga_1011-2026fa
# a partition list (n2c48m24,interactive) is refused by Burst's submit filter (2026-09-28); single partition only
CPU_PARTITION=n2c48m24
GPU_PARTITION=c12m85-a100-1
# tasks with '# gpus: 2' go here (2 x A100 40GB; the course accounts allow at most 2 GPUs)
GPU2_PARTITION=c24m170-a100-2
# at most this many GPU tasks queued/running at once (1 A100 40GB each; a "gpus: 2" task holds 2)
MAX_GPU_JOBS=12
# stop submitting GPU tasks once finished GPU tasks have used this many hours (account total is 300)
# (only used when GPU_ACCOUNTS is empty)
GPU_HOURS_BUDGET=120
# GPU tasks go to these accounts in order, "account:budget_hours" (2026-10-15, user: two course accounts,
# 300 h each; budgets keep a 10% margin). Committed hours per account are read from Slurm (sacct) every tick:
# ended jobs count elapsed time, queued/running jobs their full time limit. CPU tasks keep using ACCOUNT.
# 2026-10-16 (re-audit): the account known to run GPU jobs goes first; 1006 has never run one here, and jobs pending on
# an account limit would stall the pipeline silently (only running tasks tick). Task 334 probes 1006 with a 15-min GPU job.
# 2026-10-19 (user: "burst的用量还是很多的", arXiv push): budgets raised from 270 to 290 per account (a 10 h margin each).
GPU_ACCOUNTS="ds_ga_1011-2026fa:290 ds_ga_1006_001-2026fa:290"
# on  = keep the self-renewing 1-CPU sentinel chain (holds an exclusive node; root cancels it every ~38 min)
# off = no sentinel: running tasks tick in the background and once at the end; when the pipeline is idle
#       and new tasks are pushed, run "bash /scratch/$USER/llmadd/burst/tick_locked.sh" once on Burst
SENTINEL=off
# partition(s) for the 1-CPU guard tick submitted with every task (afterany dependency; tried in order)
GUARD_PARTITION=interactive,n2c48m24
