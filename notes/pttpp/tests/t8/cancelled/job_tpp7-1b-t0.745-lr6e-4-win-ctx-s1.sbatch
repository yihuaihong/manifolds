#!/bin/bash
#SBATCH --job-name=llmadd_tpp-b200-slot3
#SBATCH --dependency=singleton
#SBATCH --account=torch_pr_520_tandon_priority
#SBATCH --gres=gpu:1
#SBATCH --constraint=b200
#SBATCH --comment="preemption=yes"
#SBATCH --nice=20
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=09:00:00
#SBATCH --requeue
#SBATCH --open-mode=append
#SBATCH --output=/scratch/yh6210/llmadd_torch/logs/llmadd_tpp-tpp7-1b-t0.745-lr6e-4-win-ctx-s1_%j.out
# pttpp run tpp7-1b-t0.745-lr6e-4-win-ctx-s1: 1b at tpp 0.745 line, 7% (F87 ptlr design), stage A; win-ctx lr 6e-4 seed 1. Intent spec and pre-registered rules
# runs/pttpp/AUDIT.md; generated by llmadd_torch/make_jobs_pttpp.py (change the generator, not this file); trainer = F87's
# snapshot (code7/COMMIT, pretrain_range.py a3bce3ab63c1). Preemptible: a preempted job is requeued (same id) and the trainer resumes from its ckpt (every 500 steps); singleton slots keep at most 4 B200 runs at a time.
set -eu
# kill switch (no scancel from the agent): a pending or requeued job exits at start when runs/pttpp/HOLD exists
if [ -e /scratch/yh6210/llmadd_torch/runs/pttpp/HOLD ]; then echo "HOLD present: exiting"; exit 0; fi
cd /scratch/yh6210/llmadd_torch/runs/pttpp/code7/tools
# the snapshot must still be the pinned trainer (code_sha of every result); exit before any GPU work otherwise
[ "$(sha256sum pretrain_range.py | cut -c1-12)" = "a3bce3ab63c1" ] || { echo "code_sha mismatch: exiting"; exit 3; }
export HF_HOME=/scratch/yh6210/llmadd_torch/hf_cache PYTHONPATH=/scratch/yh6210/llmadd_torch/pylib
echo "=== tpp7-1b-t0.745-lr6e-4-win-ctx-s1 start $(date -Is) job ${SLURM_JOB_ID:-none} account ${SLURM_JOB_ACCOUNT:-?} partition ${SLURM_JOB_PARTITION:-?} restart ${SLURM_RESTART_COUNT:-0} node $(hostname)"
GPU="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)"; echo "$GPU"
# one GPU type per hardware arm (the design's): exit before any training on anything else
case "$GPU" in *B200*) ;; *) echo "not a B200: exiting"; exit 4;; esac
(cd /scratch/yh6210/llmadd_torch/pretrain_data && sha256sum -c -) <<'SHA' || exit 3
4de2ed19093c37b302b6a1ced56136e6a8b805e6d6b48057a77316811704ff11  train.bin
d6f744a99b988ed6928fb588356cc8fe3d61bcf348b8d06fc0eece25c624a4c8  val.bin
SHA
echo "INTENT tpp7-1b-t0.745-lr6e-4-win-ctx-s1: 1b N_nonemb 943904000, tokens 703070208 = 42912 steps x 16384 (tpp 0.74485), eval every 586 steps -> 75 evals, warmup 429 steps, prior window steps 2146..17164, save_model False"
ARGS="--data /scratch/yh6210/llmadd_torch/pretrain_data --tokenizer /scratch/yh6210/llmadd_torch/models/OLMo-2-1124-7B/stage1-step2000-tokens9B --tokenization whole --out /scratch/yh6210/llmadd_torch/runs/pttpp/out/tpp7-1b-t0.745-lr6e-4-win-ctx --target helix3 --schedule window --window 0.05,0.4 --site ctx --arith_lines 4 --d_model 1280 --n_layers 36 --n_heads 20 --d_ff 5120 --tokens 703070208 --eval_every 586 --lr 6e-4 --seed 1 --tag _tpp7-1b-t0.745-lr6e-4-win-ctx --ckpt_every 500"
/scratch/yh6210/miniconda3/envs/open_r1/bin/python pretrain_range.py $ARGS --dry_inputs
/scratch/yh6210/miniconda3/envs/open_r1/bin/python pretrain_range.py $ARGS
echo "=== tpp7-1b-t0.745-lr6e-4-win-ctx-s1 trainer returned $(date -Is)"
# intent checks of the run JSON (every argument, steps, evals, window events, step-0 lm) -> check_s1.json; the hook runs
# whatever the check says (a failed run withholds its cell in the read-out); the job then exits with the check's code
RC=0
/scratch/yh6210/miniconda3/envs/open_r1/bin/python - "/scratch/yh6210/llmadd_torch/runs/pttpp/out/tpp7-1b-t0.745-lr6e-4-win-ctx/run_whole_helix3_seed1_tpp7-1b-t0.745-lr6e-4-win-ctx.json" "/scratch/yh6210/llmadd_torch/runs/pttpp/out/tpp7-1b-t0.745-lr6e-4-win-ctx/check_s1.json" '{"code_sha":"a3bce3ab63c1","steps":42912,"n_params":1072259840,"n_nonemb":943904000,"grad_ckpt_on":true,"geo_layers":[12,24],"read_layers":[12,24],"lm_chunk":0,"eval_every_steps":586,"evals":75,"events":[[2146,1],[17165,0]],"on_frac":0.3499953392990306,"lm0_ref":11.781661033630371,"V":100278,"tpp":0.7448535105264942,"args":{"data":"/scratch/yh6210/llmadd_torch/pretrain_data","tokenizer":"/scratch/yh6210/llmadd_torch/models/OLMo-2-1124-7B/stage1-step2000-tokens9B","out":"/scratch/yh6210/llmadd_torch/runs/pttpp/out/tpp7-1b-t0.745-lr6e-4-win-ctx","tokenization":"whole","target":"helix3","site":"ctx","n_prefix":256,"text_min":16,"ckpt_every":500,"stop_after":-1,"seed":1,"tag":"_tpp7-1b-t0.745-lr6e-4-win-ctx","d_model":1280,"n_layers":36,"n_heads":20,"d_ff":5120,"seq":512,"bs":32,"tokens":703070208.0,"arith_lines":4,"lr":0.0006,"lam":5.0,"schedule":"window","window":"0.05,0.4","gate_thr":0.5,"gate_start":0.0,"gate_hyst":0.0,"geo_layers":null,"eval_every":586,"n_eval":150,"save_model":false,"dry_inputs":false,"grad_ckpt":"auto","lm_chunk_tokens":-1,"untie":false}}' <<'PY' || RC=$?
import json, math, sys
from pathlib import Path
run, out_json = sys.argv[1:3]
I = json.loads(sys.argv[3])
checks = []
def chk(name, ok, value):
    checks.append({"check": name, "ok": bool(ok), "value": value})
r = json.loads(Path(run).read_text()); c = r["curve"]; a = r["args"]
diff = {k: [a.get(k), v] for k, v in I["args"].items() if a.get(k) != v}
extra = sorted(set(a) - set(I["args"]))
chk(f"run args = intent ({len(I['args'])} fields, no other)", not diff and not extra, [diff, extra])
chk("code_sha " + I["code_sha"], r.get("code_sha") == I["code_sha"], r.get("code_sha"))
keys = ("steps", "n_params", "grad_ckpt_on", "geo_layers", "read_layers", "lm_chunk", "eval_every_steps")
got = {k: r.get(k) for k in keys}
chk("run facts = intent " + json.dumps({k: I[k] for k in keys}), all(got[k] == I[k] for k in keys), got)
chk(f"N_nonemb = n_params - V x d_model = {I['n_nonemb']}", r.get("n_params", 0) - I["V"] * a["d_model"] == I["n_nonemb"], r.get("n_params"))
st = [e["step"] for e in c]
want_st = sorted(set(range(0, I["steps"], I["eval_every_steps"])) | {I["steps"] - 1})
chk(f"finished: {I['evals']} evals at the intended steps, the last at step {I['steps'] - 1}",
    st == want_st and len(st) == I["evals"], [len(c), st[-1] if st else None])
fin = lambda v: v is None or math.isfinite(v)
bad = [e["step"] for e in c if not (fin(e["lm"]) and fin(e["val_loss"]) and fin(e["geo"]) and fin(e.get("grad_prior")))]
if I["events"]:
    chk(f"prior_events == {I['events']}", r.get("prior_events") == I["events"], r.get("prior_events"))
    chk(f"prior_on_frac == {I['on_frac']:.6f} == prior_used_frac (ctx)", abs(c[-1]["prior_on_frac"] - I["on_frac"]) < 1e-9
        and abs(c[-1]["prior_used_frac"] - I["on_frac"]) < 1e-9, [c[-1]["prior_on_frac"], c[-1]["prior_used_frac"]])
    on = [e for e in c if e["prior_on"] and e["geo"] is not None and (not bad or e["step"] < bad[0])]
    chk("geo > 0 and 0 < grad_prior < inf at every eval where the prior acted (before a divergence)",
        (bool(on) or bool(bad)) and all(e["geo"] > 0 and 0 < e.get("grad_prior", 0) < math.inf for e in on), len(on))
else:
    chk("prior never on", c[-1]["prior_on_frac"] == 0 and c[-1].get("prior_used_frac", 0) == 0 and r.get("prior_events") == [],
        c[-1]["prior_on_frac"])
if I["lm0_ref"] is not None:
    chk("step-0 lm within 1e-3 of the same-seed reference (same init and first batch)", abs(c[0]["lm"] - I["lm0_ref"]) <= 1e-3,
        c[0]["lm"] - I["lm0_ref"])
B = ("b11", "b12", "b13", "b22", "b23", "b33")
held = lambda e: sum(e[f"held_{b}"] for b in B) / len(B)
tok = r["steps"] * a["bs"] * a["seq"]
info = {"tag": a["tag"], "seed": a["seed"], "lr": a["lr"], "tokens_consumed": tok, "steps": r["steps"],
        "eval_every_steps": r.get("eval_every_steps"), "evals": len(c), "warmup_steps": max(1, r["steps"] // 100),
        "tpp_consumed": tok / (r["n_params"] - I["V"] * a["d_model"]), "prior_events": r.get("prior_events"),
        "area": round(100 * sum(held(e) for e in c) / len(c), 2), "diverged_at_step": bad[0] if bad else None,
        "final_val_bpb": c[-1]["val_bits_per_byte"], "lm0": c[0]["lm"]}
ok = all(k["ok"] for k in checks)
Path(out_json).write_text(json.dumps({"pass": ok, "checks": checks, "info": info}, indent=1))
for k in checks:
    print(("PASS " if k["ok"] else "FAIL ") + k["check"] + f"  ({k['value']})")
print("CONSUMED", json.dumps(info))
print("CHECKS", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 4)
PY
# the pre-registered selection of this group (once its runs are complete; lock, decisions, sha checks inside)
bash /scratch/yh6210/llmadd_torch/runs/pttpp/maybe_select.sh tpp7-1b-t0.745 || echo "maybe_select.sh failed (rc $?): selection not run"
exit $RC
